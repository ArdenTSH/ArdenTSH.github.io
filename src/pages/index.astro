---
// Home. A column of equal-width islands: one hero island with all the meet-me
// text (edit it in src/config/site.ts), then one island per research direction.
import PageShell from "../layouts/PageShell.astro";
import Island from "../components/Island.astro";
import BlackHole from "../components/BlackHole.astro";
import { Icon } from "astro-icon/components";
import { researchAreas, site, eden } from "../config/site";
---

<PageShell title={site.name} active="home">
  <BlackHole slot="background" />

  <Island as="header">
    <p class="eyebrow">{site.eyebrow}</p>
    <h1>{site.name}</h1>
    {site.tagline && <p class="lead">{site.tagline}</p>}
    <p class="text-secondary intro" set:html={site.intro}></p>
    <p class="hero-actions">
      <a class="hero-action" href="/cv/Arden_Tsang_CV.pdf" download>
        <Icon name="tabler:download" aria-hidden="true" /> Download my CV
        <span class="hero-note">PDF</span>
      </a>
    </p>
  </Island>

  <a class="card-link build-link" href="/eden">
    {/* controls off: the whole card is a link, a button can't live inside <a> */}
    <Island controls={false} accent>
      <div class="card-inner">
        <Icon name={eden.icon} class="card-icon" aria-hidden="true" />
        <div class="card-body">
          <p class="eyebrow">{eden.eyebrow}</p>
          <h3>{eden.title}</h3>
          <p class="text-secondary">{eden.teaser}</p>
          <span class="label card-go">
            Read more <Icon name="tabler:arrow-right" aria-hidden="true" />
          </span>
        </div>
      </div>
    </Island>
  </a>

  {
    researchAreas.map((a) => (
      <a class="card-link" href={`/research/${a.slug}`}>
        {/* controls off: the whole card is a link, a button can't live inside <a> */}
        <Island controls={false}>
          <div class="card-inner">
            <Icon name={a.icon} class="card-icon" aria-hidden="true" />
            <div class="card-body">
              <h3>{a.label}</h3>
              <p class="text-secondary">{a.blurb}</p>
              <span class="label card-go">
                Explore <Icon name="tabler:arrow-right" aria-hidden="true" />
              </span>
            </div>
          </div>
        </Island>
      </a>
    ))
  }
</PageShell>

<style>
  /* A quiet text link under the bio, not a card: the CV is a document, and the
     cards below are places to go. Matches the action link on the Eden page. */
  .hero-actions {
    margin-top: var(--space-4);
  }
  .hero-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
  }
  .hero-action :global(svg) {
    width: 16px;
    height: 16px;
  }
  .intro {
    font-size: var(--text-md);
  }
  .card-link {
    display: block;
    color: inherit;
  }
  /* The "what I'm building" card sits above the research directions; its eyebrow
     (mono kicker) sets it apart from them. */
  .build-link .eyebrow {
    margin: 0;
  }
  .card-inner {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .card-inner :global(.card-icon) {
    width: 24px;
    height: 24px;
    color: var(--accent);
    flex: none;
    margin-top: 3px;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .card-go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    margin-top: var(--space-1);
  }
  .card-go :global(svg) {
    width: 14px;
    height: 14px;
  }
  .card-link:hover :global(.island) {
    border-color: var(--border-strong);
  }
  .card-link:hover .card-go {
    color: var(--accent-strong);
  }
</style>
